# ---------------------------------------------------------------------------
# Broker selection (first match wins):
#   RABBITMQ_URL  -> RabbitMQ adapter (amqplib, topic exchange, manual ack, DLQ)
#   BROKER_URL    -> local TCP broker (tcp://host:port), zero external services
#   neither       -> in-process broker (only useful for tests / single process)
# ---------------------------------------------------------------------------
#RABBITMQ_URL=amqp://guest:guest@localhost:5672
BROKER_URL=tcp://127.0.0.1:47100

# Port the local broker server listens on (packages/common broker server)
BROKER_PORT=47100

# --- Local broker fault injection (demo / chaos knobs) ---------------------
# Comma separated topics: every matching message is delivered twice per group.
#BROKER_DUPLICATE_TOPICS=payment.cmd.charge,inventory.reserved
# Random per-delivery delay 0..N ms (introduces reordering between topics).
#BROKER_JITTER_MS=25
# Redelivery tuning
#BROKER_ACK_TIMEOUT_MS=15000
#BROKER_REDELIVERY_DELAY_MS=250
#BROKER_MAX_DELIVERIES=5

# --- Per-service settings ---------------------------------------------------
# HTTP port of the Order service REST API
PORT=3000
# SQLite file for this service (each service must get its OWN file)
#DB_PATH=data/order.db
# sqlite driver: auto (better-sqlite3 if installed, else node:sqlite) | node | better
SQLITE_DRIVER=auto

# --- OpenTelemetry ----------------------------------------------------------
# JSON-lines span file (offline default). One file per service recommended.
#OTEL_TRACES_FILE=data/traces/order.spans.jsonl
# Set to export OTLP/HTTP instead (e.g. Jaeger all-in-one): http://localhost:4318
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Print spans to stdout as well
#OTEL_TRACES_STDOUT=0

LOG_LEVEL=info
